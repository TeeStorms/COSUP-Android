<resources>
    <style name="Widget.Cosup.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/cosup_surface</item>
        <item name="strokeColor">@color/cosup_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>
    <style name="Cosup.Eyebrow" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/cosup_green</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>
    <style name="Cosup.H1" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/cosup_text</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Cosup.H2" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/cosup_text</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Cosup.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/cosup_text</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Cosup.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/cosup_text</item>
    </style>
    <style name="Cosup.Muted" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/cosup_muted</item>
    </style>
    <style name="Cosup.Badge" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/cosup_badge_text</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
