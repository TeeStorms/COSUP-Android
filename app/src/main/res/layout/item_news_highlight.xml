<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground" android:orientation="vertical"
    android:paddingTop="8dp" android:paddingBottom="8dp">
    <TextView android:id="@+id/hlTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@style/Cosup.Title" android:textSize="15sp" />
    <TextView android:id="@+id/hlMeta"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@style/Cosup.Muted" android:textSize="12sp" />
</LinearLayout>
