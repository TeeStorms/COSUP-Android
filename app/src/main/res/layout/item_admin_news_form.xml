<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Cosup.Card"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Publish a news item" android:textAppearance="@style/Cosup.Title" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilNTitle"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:hint="Title">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etNTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textCapSentences" android:maxLength="200" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilNCategory"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:hint="Category">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etNCategory"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textCapWords" android:maxLength="60" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilNBody"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:hint="Body">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etNBody"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences" android:minLines="4" android:gravity="top" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/nPublish"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="Publish" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
