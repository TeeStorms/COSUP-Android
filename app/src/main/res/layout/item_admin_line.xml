<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
    <TextView android:id="@+id/lineTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@style/Cosup.Body" android:textStyle="bold" />
    <TextView android:id="@+id/lineSub"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@style/Cosup.Muted" android:textSize="12sp" />
</LinearLayout>
