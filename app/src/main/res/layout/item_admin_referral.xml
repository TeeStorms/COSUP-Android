<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/Widget.Cosup.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/arName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@style/Cosup.Title" />
        <TextView android:id="@+id/arPhone"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="@color/cosup_green"
            android:textStyle="bold" android:padding="2dp" />
        <TextView android:id="@+id/arEmail"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@style/Cosup.Body" android:textSize="12sp" />
        <TextView android:id="@+id/arMeta"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@style/Cosup.Muted" android:textSize="12sp" />
        <TextView android:id="@+id/arMessage"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textAppearance="@style/Cosup.Body" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilStatus"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:hint="Status">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/ddStatus"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/arSave"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="Save" android:enabled="false" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
