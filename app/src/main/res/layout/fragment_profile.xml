<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="16dp" android:paddingBottom="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Your account" android:textAppearance="@style/Cosup.Eyebrow" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="My profile" android:textAppearance="@style/Cosup.H1" />
        </LinearLayout>

        <!-- not signed in -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/boxSignedOut"
            style="@style/Widget.Cosup.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Sign in to see and edit your details." android:textAppearance="@style/Cosup.Body" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSignInOut"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="Sign in / Register" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- guest -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/boxGuest"
            style="@style/Widget.Cosup.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView android:id="@+id/guestTitle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textAppearance="@style/Cosup.Title" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Guests do not have a profile. Create a free account to save your details and see your referrals."
                    android:textAppearance="@style/Cosup.Body" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCreateAccount"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="Create a free account" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnEndGuest"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="End guest session" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <ProgressBar android:id="@+id/loading"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:layout_margin="40dp"
            android:indeterminate="true" android:visibility="gone" />
        <LinearLayout android:id="@+id/errorBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_horizontal" android:orientation="vertical"
            android:padding="24dp" android:visibility="gone">
            <TextView android:id="@+id/errorText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:gravity="center" android:textColor="@color/cosup_red" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRetry"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="Try again" />
        </LinearLayout>

        <!-- signed in -->
        <LinearLayout android:id="@+id/boxUser"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Cosup.Card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="18dp">
                    <TextView android:id="@+id/profEmail"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="@style/Cosup.Muted" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilFirst"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginTop="10dp" android:layout_marginEnd="4dp" android:hint="First name">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etFirst"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="textPersonName|textCapWords" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilLast"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginTop="10dp" android:layout_marginStart="4dp" android:hint="Last name">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etLast"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="textPersonName|textCapWords" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilPhone"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:hint="Phone" >
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPhone"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="phone" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilLang"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:hint="Language">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/ddLang"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSave"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="Save changes" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="My referrals" android:textAppearance="@style/Cosup.Title" />
                <TextView android:id="@+id/refEmpty"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="You have not submitted a referral yet."
                    android:textAppearance="@style/Cosup.Muted" android:visibility="gone" />
                <LinearLayout android:id="@+id/refContainer"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAdmin"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="Open admin panel" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSignOut"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="Sign out" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
