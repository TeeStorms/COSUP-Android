<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>   <!-- emulator -> your PC -->
        <domain includeSubdomains="false">localhost</domain>  <!-- real phone with: adb reverse tcp:PORT tcp:PORT -->
